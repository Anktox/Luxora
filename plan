## Step 6 — Supabase Functions

### submitEntry:
```javascript
async function submitEntry({ twitter, wallet, replyLink, referredBy }) {
  // 1. Check duplicates
  const { data: existing } = await supabase
    .from('whitelist_entries')
    .select('id')
    .or(`twitter.eq.${twitter},wallet.eq.${wallet}`)

  if (existing?.length > 0) throw new Error('Already registered')

  // 2. Generate referral code
  const referralCode = generateReferralCode(twitter)

  // 3. Insert new entry
  const { data, error } = await supabase
    .from('whitelist_entries')
    .insert({
      twitter,
      wallet,
      reply_link: replyLink,
      points: 100,
      referral_code: referralCode,
      referred_by: referredBy || null
    })
    .select()

  if (error) throw error

  // 4. Add points to referrer
  if (referredBy) {
    const { data: referrer } = await supabase
      .from('whitelist_entries')
      .select('id, points')
      .eq('referral_code', referredBy)
      .single()

    if (referrer) {
      await supabase
        .from('whitelist_entries')
        .update({ points: referrer.points + 50 })
        .eq('referral_code', referredBy)
    }
  }

  return data[0]
}
```

### getLeaderboard:
```javascript
async function getLeaderboard(limit = 50) {
  const { data } = await supabase
    .from('whitelist_entries')
    .select('twitter, points, created_at')
    .order('points', { ascending: false })
    .limit(limit)

  return data
}
```

### getTotalCount:
```javascript
async function getTotalCount() {
  const { count } = await supabase
    .from('whitelist_entries')
    .select('*', { count: 'exact', head: true })

  return count
}
```

